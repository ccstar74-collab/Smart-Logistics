# 浏览器同源部署时保持 /api/v1；开发环境由 Vite 转发到后端，避免 CORS。
VITE_API_BASE_URL=/api/v1

# 必须改成后端 HTTP 服务的地址和端口，不是 SSH 端口。
VITE_API_PROXY_TARGET=http://111.170.148.177:58080

# 云端 Java 智能体（健康检查 /health，对话 /api/chat）
VITE_AGENT_BASE_URL=http://111.170.148.177:58081

# 实时车辆 GPS WebSocket；sim_code 字段完成前可保持此地址，前端会显示设备编号占位。
VITE_VEHICLE_WS_URL=ws://111.170.148.177:58080/ws/vehicle-locations
# 告警事件推送；两个连接都会自动追加当前登录 JWT，并每 25 秒发送文本 ping。
VITE_ALARM_WS_URL=ws://111.170.148.177:58080/ws/alarms
VITE_NOTIFICATION_WS_URL=ws://111.170.148.177:58080/ws/notifications
# ETA 推送 WebSocket；前端会自动把当前登录 JWT 追加为 ?token=...。
VITE_LOGISTICS_WS_URL=ws://111.170.148.177:58080/ws/logistics
# 车辆字典属于 REST API，通过同源 /api 代理到 58080。
VITE_REALTIME_API_BASE_URL=/api

# 仅限本地联调时临时填写；正式环境应通过登录接口取得 token。
# VITE_API_TOKEN=

VITE_AMAP_KEY=你的高德Web端JSAPI_Key
VITE_AMAP_SECURITY_CODE=你的securityJsCode
