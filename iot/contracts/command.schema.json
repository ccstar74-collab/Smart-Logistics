{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-logistics.local/schemas/command.schema.json",
  "title": "智慧物流任务路线刷新通知",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "vehicle_id",
    "command_type",
    "task_id",
    "timestamp"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "vehicle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "task_id": { "type": "integer", "minimum": 1 },
    "command_type": { "const": "TASK_ROUTE_READY" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
